{
  "name": "repairai-guard",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @repairai/api prisma:generate",
    "db:migrate": "pnpm --filter @repairai/api prisma:migrate",
    "db:seed": "pnpm --filter @repairai/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  }
}
